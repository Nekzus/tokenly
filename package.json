{
  "name": "@nekzus/tokenly",
  "version": "1.7.7",
  "description": "Secure JWT token management with advanced device fingerprinting",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "browser": "dist/index.umd.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20.8.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "jwt",
    "token",
    "authentication",
    "authorization",
    "cookie",
    "httponly",
    "security",
    "typescript",
    "oauth",
    "refresh token",
    "access token"
  ],
  "author": "nekzus",
  "license": "MIT",
  "dependencies": {
    "jsonwebtoken": "9.0.3"
  },
  "scripts": {
    "build": "pnpm exec rollup -c",
    "dev": "pnpm exec rollup -c -w",
    "lint": "pnpm exec biome lint . --write",
    "format": "pnpm exec biome format . --write",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "test:coverage": "pnpm exec vitest run --coverage",
    "commit": "git-cz",
    "semantic-release": "pnpm exec semantic-release",
    "docs:dev": "pnpm exec vitepress dev docs",
    "docs:build": "pnpm exec vitepress build docs && mkdir -p docs/.vitepress/dist/.well-known && mkdir -p docs/.vitepress/dist/tokenly && cp docs/public/llms*.txt docs/.vitepress/dist/ && cp docs/public/llms*.txt docs/.vitepress/dist/tokenly/ && touch docs/.vitepress/dist/.nojekyll",
    "docs:preview": "pnpm exec vitepress preview docs",
    "docs:deploy": "BASE=/tokenly/ pnpm run docs:build && pnpm exec gh-pages -d docs/.vitepress/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@semantic-release-extras/verified-git-commit": "1.0.11",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "13.1.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.6.1",
    "gh-pages": "6.3.0",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-polyfill-node": "0.13.0",
    "semantic-release": "24.2.9",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "3.2.7"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nekzus/tokenly.git"
  },
  "bugs": {
    "url": "https://github.com/Nekzus/tokenly/issues"
  },
  "homepage": "https://nekzus.github.io/tokenly/",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
